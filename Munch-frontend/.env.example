# Where the Django API is. Defaults to the dev server on localhost.
REACT_APP_API_URL=http://localhost:8000/api/v1

# Where Google sends somebody back after signing in.
#
# Leave this unset and the app uses whatever address the browser is on,
# which is right on a laptop at localhost. It is wrong on a phone:
# reaching the dev server across the wi-fi makes the origin something
# like http://192.168.10.130:3001, and Google refuses a private IP as a
# redirect for a web client - "Access blocked: Authorization Error".
#
# To sign in from a phone, give the app an address Google will accept
# (a deployed domain, or a tunnel such as ngrok or cloudflared), add
# that origin and <origin>/login to the Google console's authorised
# origins and redirect URIs, and set it here.
# REACT_APP_OAUTH_ORIGIN=https://your-tunnel.example.com
