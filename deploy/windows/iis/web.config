<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS in front of uvicorn.

  Copy to the site root, which is the built frontend:
      C:\munch\Munch-frontend\build\web.config

  Needs three things installed on the server, and it will fail
  quietly or oddly without any of them:

    * URL Rewrite 2.1          https://www.iis.net/downloads/microsoft/url-rewrite
    * Application Request Routing 3.0
                               https://www.iis.net/downloads/microsoft/application-request-routing
    * The "WebSocket Protocol" Windows feature
      Install-WindowsFeature Web-WebSockets   (Server)
      or Windows Features -> IIS -> Application Development -> WebSocket Protocol

  Then turn the proxy on, once, machine-wide - ARR is installed
  disabled, and every rule below silently does nothing until this is set:

      Set-WebConfigurationProperty -PSPath 'MACHINE/WEBROOT/APPHOST' `
        -Filter 'system.webServer/proxy' -Name enabled -Value True

  And allow the one server variable the rules set, which is otherwise
  refused with a 500.19:

      Add-WebConfiguration -PSPath 'MACHINE/WEBROOT/APPHOST' `
        -Filter 'system.webServer/rewrite/allowedServerVariables' `
        -Value @{name='HTTP_X_FORWARDED_PROTO'}
-->
<configuration>
  <system.webServer>

    <!--
      Django's own assets and the uploaded media are served straight
      off disk rather than through the app. Both live inside config\,
      not at the repository root, because BASE_DIR points at the
      settings package's parent.

      Django's are under /django-static/ and not /static/, because the
      React bundle owns that prefix. STATIC_URL in
      config/settings/production.py has to agree with this.
    -->

    <rewrite>
      <rules>

        <!-- Websockets. First, because the rules below would other-
             wise claim /ws/ and strip the upgrade on the way past. -->
        <rule name="ws" stopProcessing="true">
          <match url="^ws/(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="{MapScheme:{HTTPS}}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8000/ws/{R:1}" />
        </rule>

        <!-- Everything Django answers. The frontend is served from
             disk by the fallback below, so only these paths cross
             over. Django's own / redirects to the allauth login page,
             which is why / is deliberately not in this list. -->
        <rule name="django" stopProcessing="true">
          <match url="^(api|admin|accounts|api-auth|swagger|redoc)(/.*)?$" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="{MapScheme:{HTTPS}}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:0}" />
        </rule>

        <!-- Anything served off disk is already handled by IIS; this
             only catches what is left, which is a client-side route
             being loaded directly or refreshed. Without it, every URL
             except / is a 404 on reload. -->
        <rule name="spa" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile"      negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(django-static|media)/" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>

      </rules>

      <!-- What the scheme actually was. IIS has no built-in variable
           for it, and uvicorn sees plain HTTP on loopback whatever the
           browser used - so without this Django believes every request
           is insecure, builds http:// URLs, refuses secure cookies,
           and with SECURE_SSL_REDIRECT on redirects a request that
           already arrived over TLS straight back to itself. -->
      <rewriteMaps>
        <rewriteMap name="MapScheme" defaultValue="http">
          <add key="on"  value="https" />
          <add key="off" value="http" />
        </rewriteMap>
      </rewriteMaps>
    </rewrite>

    <!-- Uploaded resources and exported spreadsheets. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!-- Create React App fingerprints its bundles, so they can be
         cached hard. index.html must not be: it is what names the
         current bundle, and a cached one keeps pointing at the last
         deploy's files. -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <caching>
      <profiles>
        <add extension=".html" policy="DisableCache" kernelCachePolicy="DisableCache" />
      </profiles>
    </caching>

  </system.webServer>
</configuration>
