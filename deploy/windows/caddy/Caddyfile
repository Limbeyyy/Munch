# Munch behind Caddy, with TLS.
#
# Caddy gets a certificate from Let's Encrypt on first start and
# renews it by itself, which is the whole reason it is here rather
# than IIS: no ARR, no URL Rewrite module, no WebSocket feature to
# install, and no machine-wide settings that fail silently when
# missed.
#
# Two things have to be true before the certificate can be issued:
# the name below must resolve to this machine from the internet, and
# ports 80 and 443 must reach it. Port 80 is not optional - it is how
# the HTTP-01 challenge is answered, and renewal uses it too.
#
# Replace munch.example.np with the real name, and C:/munch with the
# checkout. Forward slashes in paths; Caddy accepts them on Windows
# and backslashes start an escape.

munch.example.np {
	encode zstd gzip

	# Django's own collected assets - the admin, the browsable API,
	# swagger. Under /django-static/ and not /static/, because the
	# React bundle owns that prefix; STATIC_URL in the settings has
	# to agree.
	#
	# Both of these live inside config/, not at the repository root,
	# because BASE_DIR points at the settings package's parent.
	handle_path /django-static/* {
		root * C:/munch/config/staticfiles
		file_server
		header Cache-Control "public, max-age=2592000"
	}

	# What people have uploaded.
	handle_path /media/* {
		root * C:/munch/config/media
		file_server
	}

	# Everything Django answers, the websockets included - Caddy
	# upgrades them without being asked to, and sets X-Forwarded-Proto,
	# X-Forwarded-For and X-Forwarded-Host on the way through. That
	# header is what stops the redirect loop, so it matters that it is
	# not something to remember.
	#
	# Django's own / redirects to the allauth login page, which is why
	# / is not in this list: it belongs to the frontend.
	@django path /api/* /admin/* /admin /accounts/* /api-auth/* /swagger/* /redoc/* /ws/*
	handle @django {
		reverse_proxy 127.0.0.1:8000 {
			# A room is quiet between one talk and the next, and the
			# client's own heartbeat is only every fifteen seconds.
			transport http {
				read_timeout 3600s
				write_timeout 3600s
			}
		}
	}

	# The built frontend, and the client-side routes it owns. try_files
	# sends anything that is not a real file to index.html, which is
	# what makes a reload on /events/3 work instead of 404ing.
	handle {
		root * C:/munch/Munch-frontend/build
		try_files {path} /index.html
		file_server

		# index.html names the current bundle, so a cached copy keeps
		# pointing at the last deploy's files. The bundles themselves
		# are content-hashed and cached hard by the header above.
		@html path *.html /
		header @html Cache-Control "no-store, must-revalidate"
	}

	# Uploaded resources and exported spreadsheets.
	request_body {
		max_size 100MB
	}

	log {
		output file C:/munch/logs/caddy.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
