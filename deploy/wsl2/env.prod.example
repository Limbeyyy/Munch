# Munch - deployed instance.
#
# Copy to /opt/munch/.env.prod, fill in, then:
#   sudo chown munch:munch /opt/munch/.env.prod
#   sudo chmod 600 /opt/munch/.env.prod
#
# systemd reads this file directly as the units' EnvironmentFile, so:
#   - no `export`
#   - no inline `#` comments after a value
#   - no quotes unless you mean them to be part of the value
#
# DJANGO_ENV=prod is set by the units, which makes base.py read
# /opt/munch/.env.prod as well. One file, read twice, which is why it
# has to be valid for both.

# -- Django ------------------------------------------------------------
SECRET_KEY=
DEBUG=False

# No default, deliberately: the instance will not start without it.
# Comma-separated, no scheme.
ALLOWED_HOSTS=munch.example.np

# Scheme and port included, unlike ALLOWED_HOSTS. Django rejects any
# POST from an origin not named here - the admin, and allauth's login.
CSRF_TRUSTED_ORIGINS=https://munch.example.np

# Where the browser loads the frontend from. Credentialed calls, so
# this cannot be a wildcard.
CORS_ALLOWED_ORIGINS=https://munch.example.np

# Leave False until a certificate is actually in place; turning it on
# first makes every request a redirect to a port nothing answers on.
SECURE_SSL_REDIRECT=False

LOG_LEVEL=INFO
LOG_DIR=/opt/munch/logs

# -- PostgreSQL --------------------------------------------------------
DB_NAME=munch_db
DB_USER=munch
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Optional read replica. Naming a host is what asks for one.
# DB_REPLICA_HOST=
# DB_REPLICA_PASSWORD=

# -- Redis -------------------------------------------------------------
# Three logical databases on one server: Celery's broker, the cache,
# and the channel layer.
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
REDIS_WS_URL=redis://localhost:6379/2

# Channels reads host and port separately rather than from the URLs
# above. Setting only the URLs leaves the channel layer pointed at a
# default localhost - which happens to be right here, and will not be
# the day Redis moves.
REDIS_HOST=localhost
REDIS_PORT=6379

# -- Secrets -----------------------------------------------------------
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
JWT_SECRET=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts the stored Google refresh tokens. Changing it does not
# re-encrypt them: every connected Drive account has to reconnect.
ENCRYPTION_KEY=

# -- Google OAuth ------------------------------------------------------
# The authorised redirect URI in Google Cloud Console must be
# https://<your host>/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file,https://www.googleapis.com/auth/drive.metadata.readonly

# -- Email -------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# -- Celery ------------------------------------------------------------
CELERY_ALWAYS_EAGER=False
CELERY_EAGER_PROPAGATES=False

# -- Misc --------------------------------------------------------------
SITE_ID=1
RATELIMIT_ENABLE=True
RATELIMIT_REQUESTS=60
RATELIMIT_PERIOD=60

# -- Nepal Payment Solution OnePG --------------------------------------
NEPALPAYMENT_CHECKOUT_URL=https://eg-uat.nepalpayment.com/
NEPALPAYMENT_CALLBACK_URL=https://munch.example.np/api/payments/callback/
NEPALPAYMENT_MERCHANT_ID=
NEPALPAYMENT_API_USERNAME=
NEPALPAYMENT_API_PASSWORD=
NEPALPAYMENT_KEY=
