# ========================================
# Meeting Platform - Environment Variables
# ========================================

# Django Core
# ---------------------------------------------------------------------
# SECRET_KEY: Used for cryptographic signing. Generate a strong key.
# Use: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# DEBUG: Set to True for development, False for production
DEBUG=True

# ALLOWED_HOSTS: Comma-separated list of domains/IPs
# For development: localhost,127.0.0.1
# For production: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
# ---------------------------------------------------------------------
DB_NAME=meeting_platform
DB_USER=meeting_user
DB_PASSWORD=meeting_password
DB_HOST=localhost
DB_PORT=5432

# Redis (for caching, WebSocket layer, Celery broker)
# ---------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
REDIS_WS_URL=redis://localhost:6379/2

# Redis host/port (used by Channels)
REDIS_HOST=localhost
REDIS_PORT=6379

# Celery
# ---------------------------------------------------------------------
CELERY_ALWAYS_EAGER=False   # Set to True to run tasks synchronously (for testing)
CELERY_EAGER_PROPAGATES=False

# Google OAuth 2.0
# ---------------------------------------------------------------------
# Get these from Google Cloud Console -> APIs & Services -> Credentials
# Create an OAuth 2.0 Client ID with application type "Web application"
# Add authorized redirect URIs: http://localhost:8000/accounts/google/login/callback/
# For production: https://yourdomain.com/accounts/google/login/callback/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Drive Scopes (space-separated)
# Keep minimal: drive.file and drive.metadata.readonly are enough
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file,https://www.googleapis.com/auth/drive.metadata.readonly

# Encryption (for sensitive tokens like Google refresh tokens)
# ---------------------------------------------------------------------
# Generate a 32-byte base64-encoded key for Fernet encryption.
# Use: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-32-byte-base64-key-here

# JWT (for REST API)
# ---------------------------------------------------------------------
# You can use the same SECRET_KEY, but it's better to use a separate one.
JWT_SECRET=your-jwt-secret-key

# CORS (Cross-Origin Resource Sharing)
# ---------------------------------------------------------------------
# Comma-separated list of allowed origins for your frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://your-frontend-domain.com

# Rate Limiting
# ---------------------------------------------------------------------
RATELIMIT_ENABLE=True
RATELIMIT_REQUESTS=60      # requests per period
RATELIMIT_PERIOD=60        # period in seconds

# Django Allauth (Social Account)
# ---------------------------------------------------------------------
# Site ID (usually 1 for default site)
SITE_ID=1

# Production Security Settings (overridden by DEBUG=False)
# ---------------------------------------------------------------------
# If DEBUG=False, these will be enforced:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# etc.

# Optional: Logging level
# ---------------------------------------------------------------------
LOG_LEVEL=INFO   # DEBUG, INFO, WARNING, ERROR, CRITICAL